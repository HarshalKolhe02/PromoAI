# AI Model Provider Configuration
AI_PROVIDER=mock
AI_MODEL=mock-deterministic-v1

# Production Provider Keys (Leave blank when using mock provider)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Custom Endpoints (for OpenAI-compatible or local models)
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434

# Generation Parameters
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_TIMEOUT=120

# Chunking & Processing Parameters
MAX_CHUNK_SIZE=12000
CHUNK_OVERLAP=500

# App Environment & Logging
APP_ENV=development
LOG_LEVEL=INFO

# Live AI Test Guard (Set to true only when explicitly executing scripts/run_live_tests.py)
RUN_LIVE_AI_TESTS=false
